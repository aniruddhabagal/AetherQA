# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Mem0
MEM0_API_KEY=m0-...
# OR for self-hosted:
# MEM0_SELF_HOSTED_URL=http://localhost:8000

# Database (results store + LangGraph checkpointer)
DATABASE_URL=postgresql://qa:qa@localhost:5432/agentic_qa

# Service
PORT=4000
NODE_ENV=development

# App under test (set per run, or default here)
DEFAULT_TARGET_URL=https://staging.yourapp.com

# Test credentials (used by auth setup)
TEST_USER_EMAIL=qa-test@yourapp.com
TEST_USER_PASSWORD=...
TEST_ADMIN_EMAIL=qa-admin@yourapp.com
TEST_ADMIN_PASSWORD=...
TEST_TOTP_SECRET=...

# QA Dashboard auth
DASHBOARD_SECRET=...

# GitHub Codebase Integration (Week 3 — read-only access to app source repo)
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=your-org
GITHUB_REPO=your-app-repo
GITHUB_DEFAULT_BRANCH=main
GITHUB_MCP_URL=http://github-mcp:8080/sse
